> class _PhaseTimer:
>     """Scratch instrument (SGLANG_DFLASH_PHASE_TIMING=1): GPU-synchronised wall per cycle phase."""
> 
>     on = os.environ.get("SGLANG_DFLASH_PHASE_TIMING", "0") == "1"
>     acc = {}
>     n = 0
> 
>     def __init__(self):
>         if self.on:
>             import time
> 
>             self.clock = time.perf_counter
>             torch.cuda.synchronize()
>             self.t = self.clock()
> 
>     def mark(self, name, seq=None):
>         if not self.on:
>             return
>         torch.cuda.synchronize()
>         now = self.clock()
>         _PhaseTimer.acc.setdefault(name, []).append((now - self.t) * 1e3)
>         self.t = now
>         if seq is not None:
>             _PhaseTimer.n += 1
>             if _PhaseTimer.n % 50 == 0:
>                 import statistics
> 
>                 logger.info(
>                     "DFLASH_PHASE seq=%d %s",
>                     seq,
>                     " ".join(
>                         f"{k}={statistics.median(v):.3f}"
>                         for k, v in _PhaseTimer.acc.items()
>                     ),
>                 )
>                 _PhaseTimer.acc = {}
> 
> 
> def _phase_timer():
>     return _PhaseTimer()
