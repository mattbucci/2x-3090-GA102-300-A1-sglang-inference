@@ -0,0 +1,58 @@
+"""[3090 inkling2-ampere] Torch fallbacks for Inkling 2's CuTe-DSL kernels (rms_norm, qk_l2_clip,
+attn_res) on GPUs below SM90, with the CuTe kernels' exact semantics (fp32 math, same eps)."""
+
+import functools
+
+import torch
+
+
+@functools.cache
+def use_ampere_fallbacks() -> bool:
+    return torch.cuda.is_available() and torch.cuda.get_device_capability()[0] < 9
+
+
+def rms_norm(x, weight, eps, *, pre_weight=None, output_dtype=None, out=None):
+    output_dtype = output_dtype or x.dtype
+    xf = x.float()
+    if pre_weight is not None:
+        xf = xf * pre_weight.float()
+    y = xf * torch.rsqrt(xf.square().mean(-1, keepdim=True) + eps)
+    if weight is not None:
+        y = y * weight.float()
+    y = y.to(output_dtype)
+    if out is not None:
+        out.copy_(y)
+        return out
+    return y
+
+
+def qk_l2_clip_fwd(x, threshold, eps=1e-6, *, output_dtype=None, scale=None, output_scale=None):
+    output_dtype = output_dtype or x.dtype
+    n = x.shape[-1]
+    xf = x.reshape(-1, n).float()
+    if scale is not None:
+        if scale.ndim == 1:
+            xf = xf * scale.float()
+        else:
+            xf = (xf.view(-1, scale.shape[0], n) * scale.float()).view(-1, n)
+    coeff = (threshold / (torch.linalg.vector_norm(xf, dim=-1, keepdim=True) + eps)).clamp(max=1.0)
+    y = xf * coeff
+    if output_scale is not None:
+        y = y.to(output_dtype).float() * output_scale.repeat_interleave(xf.shape[0] // output_scale.numel())[:, None]
+    return y.to(output_dtype)
+
+
+def attn_res(blocks, partial_addend, queries, *, normalize_values=False, eps=1e-6):
+    """Softmax over sources n of rstd_n * <x_n, q>; output sum_n p_n * x_n (times rstd_n with
+    normalize_values). The last block gets partial_addend added. Returns a tuple of fp32
+    [tokens, width] tensors, one per query."""
+    xs = torch.stack([b.float() for b in blocks])  # [N, T, W]
+    if partial_addend is not None:
+        xs[-1] += partial_addend.float()
+    rstd = torch.rsqrt(xs.square().mean(-1) + eps)  # [N, T]
+    logits = torch.einsum("ntw,qw->qnt", xs, queries.float()) * rstd  # [Q, N, T]
+    p = torch.softmax(logits, dim=1)
+    if normalize_values:
+        p = p * rstd
+    out = torch.einsum("qnt,ntw->qtw", p, xs).contiguous()  # callers need contiguous rows
+    return tuple(out.unbind(0))
