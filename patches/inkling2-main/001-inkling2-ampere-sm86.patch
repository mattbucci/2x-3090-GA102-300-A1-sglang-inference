diff --git a/python/sglang/kernels/ops/attention/inkling2_rel_bias_ampere.py b/python/sglang/kernels/ops/attention/inkling2_rel_bias_ampere.py
new file mode 100644
index 0000000000..dc83c8b443
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/inkling2_rel_bias_ampere.py
@@ -0,0 +1,322 @@
+"""[3090 inkling2-ampere] Paged attention with Inkling 2's compact relative bias for GPUs without FA4
+(Ampere sm_80/sm_86): scores = q.k * scale + rel_bias[token, head, d] for backward distance
+0 <= d < extent (0 elsewhere), causal, optional sliding window. Returns the softmax-normalized output
+WITHOUT the sink and its log-sum-exp, the contract FA4's return_lse path feeds to gate_sink.
+
+Split-KV: grid (query block, head, split); each split walks its share of the sequence's keys and
+writes (o, m, l) partials that a second kernel merges into (o, lse). Keys come from the paged pool
+(the new tokens' K/V are written before the call), addressed through kv_indices.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _rel_bias_attn_partials(
+    Q, K, V, Bias, KvIndices,
+    QStart, QLen, KvStart, KvLen, KvFirst,
+    BlockSeq, BlockQ0,
+    OP, MP, LP,
+    scale,
+    sq_t, sq_h, sk_t, sk_h, sb_t, sb_h,
+    so_s, so_t, so_h, sm_s, sm_t,
+    GROUP: tl.constexpr, D: tl.constexpr, EXTENT: tl.constexpr, WINDOW: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, NUM_SPLITS: tl.constexpr,
+):
+    blk = tl.program_id(0)
+    head = tl.program_id(1)
+    split = tl.program_id(2)
+    seq = tl.load(BlockSeq + blk)
+    q0 = tl.load(BlockQ0 + blk)  # first query row of this block, relative to the sequence
+    q_start = tl.load(QStart + seq)
+    q_len = tl.load(QLen + seq)
+    kv_start = tl.load(KvStart + seq)
+    kv_len = tl.load(KvLen + seq)
+    kv_first = tl.load(KvFirst + seq)  # first absolute position present in KvIndices
+    kvh = head // GROUP
+
+    offs_m = q0 + tl.arange(0, BLOCK_M)
+    m_valid = offs_m < q_len
+    pos = kv_len - q_len + offs_m  # absolute position of each query row
+    offs_d = tl.arange(0, D)
+    q = tl.load(Q + (q_start + offs_m)[:, None] * sq_t + head * sq_h + offs_d[None, :],
+                mask=m_valid[:, None], other=0.0)
+
+    # keys this block can see: [lo, hi)
+    hi = tl.minimum(kv_len, kv_len - q_len + q0 + BLOCK_M)
+    lo = 0
+    if WINDOW > 0:
+        lo = tl.maximum(0, kv_len - q_len + q0 - WINDOW + 1)
+    lo = tl.maximum(lo, kv_first)
+    span = hi - lo
+    per = tl.cdiv(tl.cdiv(span, NUM_SPLITS), BLOCK_N) * BLOCK_N
+    s_lo = lo + split * per
+    s_hi = tl.minimum(hi, s_lo + per)
+
+    m_i = tl.full([BLOCK_M], float("-inf"), tl.float32)
+    l_i = tl.zeros([BLOCK_M], tl.float32)
+    acc = tl.zeros([BLOCK_M, D], tl.float32)
+    bias_row = Bias + (q_start + offs_m)[:, None] * sb_t + head * sb_h
+    for start in range(s_lo, s_hi, BLOCK_N):
+        offs_n = start + tl.arange(0, BLOCK_N)
+        n_valid = offs_n < s_hi
+        loc = tl.load(KvIndices + kv_start + offs_n, mask=n_valid, other=0).to(tl.int64)
+        k = tl.load(K + loc[None, :] * sk_t + kvh * sk_h + offs_d[:, None], mask=n_valid[None, :], other=0.0)
+        s = tl.dot(q, k.to(q.dtype)) * scale
+        dist = pos[:, None] - offs_n[None, :]
+        visible = n_valid[None, :] & m_valid[:, None] & (dist >= 0)
+        if WINDOW > 0:
+            visible = visible & (dist < WINDOW)
+        in_ext = visible & (dist < EXTENT)
+        b = tl.load(bias_row + tl.where(in_ext, dist, 0), mask=in_ext, other=0.0).to(tl.float32)
+        s = tl.where(visible, s + b, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        alpha = tl.exp(m_i - m_safe)
+        p = tl.exp(s - m_safe[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        v = tl.load(V + loc[:, None] * sk_t + kvh * sk_h + offs_d[None, :], mask=n_valid[:, None], other=0.0)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), v.to(q.dtype))
+        m_i = m_new
+    rows = q_start + offs_m
+    tl.store(OP + split * so_s + rows[:, None] * so_t + head * so_h + offs_d[None, :], acc, mask=m_valid[:, None])
+    tl.store(MP + split * sm_s + rows * sm_t + head, m_i, mask=m_valid)
+    tl.store(LP + split * sm_s + rows * sm_t + head, l_i, mask=m_valid)
+
+
+@triton.jit
+def _rel_bias_decode_grouped(
+    Q, K, V, Bias, KvIndices, KvStart, KvLen, KvFirst,
+    OP, MP, LP,
+    scale,
+    sq_t, sq_h, sk_t, sk_h, sb_t, sb_h,
+    so_s, so_t, so_h, sm_s, sm_t,
+    GROUP: tl.constexpr, ROWS: tl.constexpr, D: tl.constexpr, EXTENT: tl.constexpr,
+    WINDOW: tl.constexpr, BLOCK_N: tl.constexpr, NUM_SPLITS: tl.constexpr,
+):
+    """Decode (one query per sequence): one program per (sequence, KV head, split); the
+    KV head's GROUP query heads are the rows, so each K/V tile is read once."""
+    seq = tl.program_id(0)
+    kvh = tl.program_id(1)
+    split = tl.program_id(2)
+    kv_start = tl.load(KvStart + seq)
+    kv_len = tl.load(KvLen + seq)
+    kv_first = tl.load(KvFirst + seq)
+    pos = kv_len - 1
+    rows = tl.arange(0, ROWS)
+    r_valid = rows < GROUP
+    heads = kvh * GROUP + rows
+    offs_d = tl.arange(0, D)
+    q = tl.load(Q + seq * sq_t + heads[:, None] * sq_h + offs_d[None, :], mask=r_valid[:, None], other=0.0)
+    lo = kv_first
+    if WINDOW > 0:
+        lo = tl.maximum(lo, kv_len - WINDOW)
+    span = kv_len - lo
+    per = tl.cdiv(tl.cdiv(span, NUM_SPLITS), BLOCK_N) * BLOCK_N
+    s_lo = lo + split * per
+    s_hi = tl.minimum(kv_len, s_lo + per)
+    m_i = tl.full([ROWS], float("-inf"), tl.float32)
+    l_i = tl.zeros([ROWS], tl.float32)
+    acc = tl.zeros([ROWS, D], tl.float32)
+    bias_row = Bias + seq * sb_t + heads[:, None] * sb_h
+    for start in range(s_lo, s_hi, BLOCK_N):
+        offs_n = start + tl.arange(0, BLOCK_N)
+        n_valid = offs_n < s_hi
+        loc = tl.load(KvIndices + kv_start + offs_n, mask=n_valid, other=0).to(tl.int64)
+        k = tl.load(K + loc[None, :] * sk_t + kvh * sk_h + offs_d[:, None], mask=n_valid[None, :], other=0.0)
+        s = tl.dot(q, k.to(q.dtype)) * scale
+        dist = pos - offs_n
+        in_ext = n_valid & (dist < EXTENT)
+        b = tl.load(bias_row + tl.where(in_ext, dist, 0)[None, :], mask=r_valid[:, None] & in_ext[None, :], other=0.0).to(tl.float32)
+        s = tl.where(n_valid[None, :], s + b, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        alpha = tl.exp(m_i - m_safe)
+        p = tl.exp(s - m_safe[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        v = tl.load(V + loc[:, None] * sk_t + kvh * sk_h + offs_d[None, :], mask=n_valid[:, None], other=0.0)
+        acc = acc * alpha[:, None] + tl.dot(p.to(q.dtype), v.to(q.dtype))
+        m_i = m_new
+    tl.store(OP + split * so_s + seq * so_t + heads[:, None] * so_h + offs_d[None, :], acc, mask=r_valid[:, None])
+    tl.store(MP + split * sm_s + seq * sm_t + heads, m_i, mask=r_valid)
+    tl.store(LP + split * sm_s + seq * sm_t + heads, l_i, mask=r_valid)
+
+
+@triton.jit
+def _rel_bias_extend_grouped(
+    Q, K, V, Bias, KvIndices,
+    QStart, QLen, KvStart, KvLen, KvFirst,
+    BlockSeq, BlockQ0,
+    OP, MP, LP,
+    scale,
+    sq_t, sq_h, sk_t, sk_h, sb_t, sb_h,
+    so_s, so_t, so_h, sm_s, sm_t,
+    GROUP: tl.constexpr, ROWS: tl.constexpr, BLOCK_T: tl.constexpr, D: tl.constexpr,
+    EXTENT: tl.constexpr, WINDOW: tl.constexpr, BLOCK_N: tl.constexpr, NUM_SPLITS: tl.constexpr,
+):
+    """Extend: one program per (query block of BLOCK_T tokens, KV head, split). Row r is
+    token q0 + r // GROUP of query head kvh * GROUP + r % GROUP, so each K/V tile serves
+    all GROUP heads of its KV head."""
+    blk = tl.program_id(0)
+    kvh = tl.program_id(1)
+    split = tl.program_id(2)
+    seq = tl.load(BlockSeq + blk)
+    q0 = tl.load(BlockQ0 + blk)
+    q_start = tl.load(QStart + seq)
+    q_len = tl.load(QLen + seq)
+    kv_start = tl.load(KvStart + seq)
+    kv_len = tl.load(KvLen + seq)
+    kv_first = tl.load(KvFirst + seq)
+    rows = tl.arange(0, ROWS)
+    t_off = rows // GROUP
+    heads = kvh * GROUP + rows % GROUP
+    tok = q0 + t_off
+    r_valid = (t_off < BLOCK_T) & (tok < q_len)
+    pos = kv_len - q_len + tok
+    offs_d = tl.arange(0, D)
+    q = tl.load(Q + (q_start + tok)[:, None] * sq_t + heads[:, None] * sq_h + offs_d[None, :],
+                mask=r_valid[:, None], other=0.0)
+    hi = tl.minimum(kv_len, kv_len - q_len + q0 + BLOCK_T)
+    lo = kv_first
+    if WINDOW > 0:
+        lo = tl.maximum(lo, kv_len - q_len + q0 - WINDOW + 1)
+    span = hi - lo
+    per = tl.cdiv(tl.cdiv(span, NUM_SPLITS), BLOCK_N) * BLOCK_N
+    s_lo = lo + split * per
+    s_hi = tl.minimum(hi, s_lo + per)
