diff --git a/python/sglang/srt/models/inkling_common/inkling2_attn_ampere.py b/python/sglang/srt/models/inkling_common/inkling2_attn_ampere.py
new file mode 100644
index 0000000000..433742d0ec
--- /dev/null
+++ b/python/sglang/srt/models/inkling_common/inkling2_attn_ampere.py
@@ -0,0 +1,112 @@
+"""[3090 inkling2-ampere] Inkling 2 attention on the Triton backend for GPUs without FA4.
+
+The layer's K/V are written through the Triton backend's write locations (window sub-pool aware),
+then inkling2_rel_bias_ampere attends over the backend's read rail (full or window-clipped) plus
+the new tokens, and returns (o, lse) for the model's gate_sink epilogue."""
+
+import torch
+
+from sglang.kernels.ops.attention.inkling2_rel_bias_ampere import rel_bias_attention
+from sglang.srt.mem_cache.memory_pool import KVWriteLoc
+from sglang.srt.model_executor.forward_context import get_attn_backend
+
+
+def _triton_backend(forward_batch):
+    """The TritonAttnBackend serving this forward, unwrapping hybrid wrappers
+    (InklingShortConvHybridAttnBackend.full_attn_backend, HybridAttnBackend's pair)."""
+    from sglang.srt.layers.attention.triton_backend import TritonAttnBackend
+
+    decode = forward_batch.forward_mode.is_decode_or_idle()
+    order = (
+        ("full_attn_backend", "decode_backend", "prefill_backend")
+        if decode
+        else ("full_attn_backend", "prefill_backend", "decode_backend")
+    )
+    backend, seen = get_attn_backend(), set()
+    while backend is not None and id(backend) not in seen:
+        if isinstance(backend, TritonAttnBackend):
+            return backend
+        seen.add(id(backend))
+        backend = next((getattr(backend, n) for n in order if getattr(backend, n, None) is not None), None)
+    raise RuntimeError(f"Inkling2 Ampere attention needs the triton backend, got {type(get_attn_backend()).__name__}")
+
+
+def ampere_attention(q, k, v, rel_bias, attn, forward_batch, *, window):
+    """q [T, H, D], k / v [T, Hkv, D] (this forward's tokens), rel_bias [T, H, extent].
+    Returns (o [T, H*D] fp32, lse [T, H] fp32)."""
+    backend = _triton_backend(forward_batch)
+    meta = backend.forward_metadata
+    layer_id = attn.layer_id
+    window_locs = backend._window_write_locs()
+    backend._set_kv_buffer(
+        forward_batch, attn, KVWriteLoc.for_batch(forward_batch, window_locs=window_locs), k, v
+    )
+    sub_pool = backend.kv_layers.route(layer_id).sub_pool
+    write_loc = (
+        window_locs[sub_pool]
+        if window_locs is not None and sub_pool in window_locs
+        else forward_batch.out_cache_loc
+    )
+    if window and attn.sliding_window_size is not None and attn.sliding_window_size > -1:
+        kv_indptr, kv_indices, _ = backend._window_rail(attn)
+    else:
+        kv_indptr, kv_indices = meta.kv_indptr, meta.kv_indices
+    kv_read = backend.kv_layers.read(layer_id)
+    k_buf, v_buf = kv_read.key(), kv_read.value()
+    bs = forward_batch.batch_size
+    seq_lens = forward_batch.seq_lens[:bs].to(torch.int32)
+    tokens = q.shape[0]
+    dev = q.device
+    if forward_batch.forward_mode.is_decode_or_idle():
+        # the decode rail already holds the new token
+        q_start = torch.arange(bs, dtype=torch.int32, device=dev)
+        q_len = torch.ones(bs, dtype=torch.int32, device=dev)
+        rail_start = kv_indptr[:bs].to(torch.int32)
+        rail_len = (kv_indptr[1 : bs + 1] - kv_indptr[:bs]).to(torch.int32)
+        indices = kv_indices
+        q_len_cpu = [1] * bs
+    else:
+        # extend: the rail covers the cached prefix only; append this forward's write locs
+        qo_indptr = meta.qo_indptr[: bs + 1]
+        q_start = qo_indptr[:bs].to(torch.int32)
+        q_len = (qo_indptr[1:] - qo_indptr[:-1]).to(torch.int32)
+        prefix_len = (kv_indptr[1 : bs + 1] - kv_indptr[:bs]).to(torch.int32)
+        rail_len = prefix_len + q_len
+        comb_indptr = torch.zeros(bs + 1, dtype=torch.int64, device=dev)
+        comb_indptr[1:] = torch.cumsum(rail_len, 0)
+        q_len_cpu = list(forward_batch.extend_seq_lens_cpu)
+        prefix_total = int(kv_indptr[bs].item()) if bs else 0
+        total = prefix_total + tokens
+        indices = torch.empty(total, dtype=kv_indices.dtype, device=dev)
+        seq_of_prefix = torch.repeat_interleave(
+            torch.arange(bs, device=dev), prefix_len.long(), output_size=prefix_total
+        )
+        j = torch.arange(prefix_total, device=dev)
+        indices[comb_indptr[seq_of_prefix] + (j - kv_indptr[seq_of_prefix])] = kv_indices[:prefix_total]
+        seq_of_new = torch.repeat_interleave(
+            torch.arange(bs, device=dev), q_len.long(), output_size=tokens
+        )
+        i = torch.arange(tokens, device=dev)
+        indices[comb_indptr[seq_of_new] + prefix_len[seq_of_new] + (i - qo_indptr[seq_of_new])] = write_loc[:tokens].to(
+            indices.dtype
+        )
+        rail_start = comb_indptr[:bs].to(torch.int32)
+    kv_first = seq_lens - rail_len
+    o, lse = rel_bias_attention(
+        q,
+        k_buf.view(k_buf.shape[0], -1, q.shape[-1]),
+        v_buf.view(v_buf.shape[0], -1, q.shape[-1]),
+        rel_bias,
+        indices,
+        q_start,
+        q_len,
+        rail_start - kv_first,
+        seq_lens,
+        q_len_cpu,
+        scale=attn.scaling,
+        window=window,
+        kv_first=kv_first,
+        out_dtype=torch.float32,
+        decode=forward_batch.forward_mode.is_decode_or_idle(),
+    )
+    return o.reshape(tokens, -1), lse
