+    def _extend_flashinfer_prefill(
+        self, q3, o3, layer, forward_batch, kv_indices, k_descale, v_descale, sinks
+    ) -> bool:
+        """[3090 080] flashinfer paged prefill for one causal extend; False = declined (Triton runs)."""
+        st = getattr(self, "_extend_fi_state", None)
+        if st is None:
+            st = self._extend_fi_state = {"ok": True, "wrappers": {}}
+            try:
+                import flashinfer
+
+                st["cls"] = flashinfer.BatchPrefillWithPagedKVCacheWrapper
+                st["ws"] = torch.empty(128 * 1024 * 1024, dtype=torch.uint8, device=q3.device)
+                st["ones"] = torch.ones(1, dtype=torch.int32, device=q3.device)
+            except Exception as e:  # noqa: BLE001
+                st["ok"] = False
+                logger.warning("[3090 080] flashinfer prefill route unavailable: %r", e)
+        if not st["ok"]:
+            return False
+        k_buf = self.token_to_kv_pool.get_key_buffer(layer.layer_id)
+        v_buf = self.token_to_kv_pool.get_value_buffer(layer.layer_id)
+        if k_buf.dim() != 3 or v_buf.dim() != 3 or k_buf.dtype != v_buf.dtype:
+            return False
+        n_new = int(forward_batch.extend_seq_lens_cpu[0])
+        n_prefix = int(forward_batch.extend_prefix_lens_cpu[0])
+        h_q, h_kv, d = layer.tp_q_head_num, layer.tp_k_head_num, layer.qk_head_dim
+        shape = (h_q, h_kv, d, q3.dtype, k_buf.dtype)
+        try:
+            w = st["wrappers"].get(shape)
+            if w is None:
+                w = st["wrappers"][shape] = st["cls"](st["ws"], "NHD")
+                logger.info("[3090 080] flashinfer prefill route active: heads %d/%d dim %d kv %s, from %d rows",
+                            h_q, h_kv, d, k_buf.dtype, _EXTEND_FI_MIN_ROWS)
+            # one plan per forward batch and shape: every full-attention layer shares the slot table
+            # (the marker lives on the batch object: an id() can be reused by a later batch)
+            planned = getattr(forward_batch, "_extend_fi_planned", None)
+            if planned is None:
+                planned = forward_batch._extend_fi_planned = set()
+            if shape not in planned:
+                # int32 slot table: an int64 one runs the same kernel at x1.76 (156 vs 89 ms at 123K prefix x 8192 rows)
+                idx = torch.cat([kv_indices[:n_prefix].to(torch.int32), forward_batch.out_cache_loc.to(torch.int32)])
+                st.setdefault("idx", {})[shape] = idx  # keep alive: the plan holds the pointer
+                w.plan(
+                    torch.tensor([0, n_new], dtype=torch.int32, device=q3.device),
+                    torch.tensor([0, n_prefix + n_new], dtype=torch.int32, device=q3.device),
+                    idx, st["ones"], h_q, h_kv, d, 1,
+                    causal=True, sm_scale=layer.scaling, q_data_type=q3.dtype, kv_data_type=k_buf.dtype,
+                )
+                planned.add(shape)
+            kw = {}
+            if layer.k_scale is not None and layer.v_scale is not None:
+                kw = dict(k_scale=k_descale, v_scale=v_descale)
+            out, lse = w.run(q3.contiguous(), (k_buf.unsqueeze(1), v_buf.unsqueeze(1)), return_lse=True, **kw)
+        except Exception as e:  # noqa: BLE001
+            st["ok"] = False
+            logger.warning("[3090 080] flashinfer prefill route declined, Triton extend from here: %r", e)
+            return False
+        if sinks is not None:
+            # the sink joins the softmax denominator only: o *= Z / (Z + exp(sink)); flashinfer's LSE is log2
+            out = out * torch.sigmoid(lse * _LN2 - sinks.view(1, -1).to(lse.dtype)).unsqueeze(-1).to(out.dtype)
+        o3.copy_(out)
+        return True
+
     def _forward_extend_kernel(self, layer, *args, **kwargs):
         if self.dllm_attention is not None:
             return self.dllm_attention.forward_extend(layer, *args, **kwargs)
