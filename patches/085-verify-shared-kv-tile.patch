+
+def _env_tile():
+    """SGLANG_VERIFY_SHARED_KV_TILE="BLOCK_H,BLOCK_N,num_warps" overrides the
+    stage-1 tile for every head_dim (unset / malformed = the table above)."""
+    raw = os.environ.get("SGLANG_VERIFY_SHARED_KV_TILE", "").strip()
+    if not raw:
+        return None
+    try:
+        block_h, block_n, num_warps = (int(x) for x in raw.split(","))
+    except ValueError:
+        return None
+    if block_h < 1 or block_h & (block_h - 1) or block_n < 1 or num_warps < 1:
+        return None
+    return (block_h, block_n, num_warps)
+
+
+_ENV_TILE = _env_tile()
+# head_dims whose env tile overflowed shared memory at compile time (e.g. a
+# 256-key tile over a bf16 KV); they keep the table tile for the process.
+_ENV_TILE_OVERFLOW = set()
+
+
 def block_config(head_dim):
     """
     Return (BLOCK_H, BLOCK_N, num_warps) for a head_dim; default for untuned
     dims. BLOCK_H must be a power of 2 (heads beyond H_Q are masked).
     """
+    if _ENV_TILE is not None and head_dim not in _ENV_TILE_OVERFLOW:
+        return _ENV_TILE
     return _BLOCK_CONFIG.get(
         head_dim, (DEFAULT_BLOCK_H, DEFAULT_BLOCK_N, DEFAULT_NUM_WARPS)
     )
