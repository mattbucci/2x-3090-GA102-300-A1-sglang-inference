--- a/python/sglang/srt/models/gemma4_mtp.py
+++ b/python/sglang/srt/models/gemma4_mtp.py
@@ -35,6 +35,52 @@ from sglang.srt.runtime_context import get_parallel
 from sglang.srt.speculative.frozen_kv_mtp_info import FrozenKVMTPContext
 from sglang.srt.utils import add_prefix
 
+import os as _os
+
+# [3090 097] topk == 1 draft head: each TP rank scores its share of the vocabulary and the ranks
+# exchange (max, index) through one all-reduce, instead of every rank reading the whole tied head
+# (262144 x 1024 bf16 = 0.54 GB per draft step on gemma4-31b). 0 = upstream full-vocabulary logits.
+_SPLIT_ARGMAX = _os.environ.get("SGLANG_MTP_DRAFT_SPLIT_ARGMAX", "0") == "1"
+
+
+class _SplitArgmaxLogitsProcessor(LogitsProcessor):
+    """Returns logits that are 0 everywhere and 1 at the exact argmax of ``hidden @ W.T``.
+
+    Only valid for a greedy (topk == 1) draft: the worker reads nothing but the top token.
+    Ties resolve to the lowest token id, as ``torch.max`` over the full row does.
+    """
+
+    def _compute_lm_head(self, hidden_states, lm_head, embedding_bias=None, *, out=None):
+        group = get_parallel().tp_group
+        rank, size = (0, 1) if group is None else (group.rank_in_group, group.world_size)
+        weight = lm_head.weight
+        vocab = weight.shape[0]
+        if size <= 1 or embedding_bias is not None or hidden_states.dim() != 2:
+            return super()._compute_lm_head(hidden_states, lm_head, embedding_bias, out=out)
+        share = vocab // size
+        lo = rank * share
+        hi = vocab if rank == size - 1 else lo + share
+        part = torch.matmul(hidden_states.to(weight.dtype), weight[lo:hi].T)
+        val, idx = part.max(dim=-1)
+        idx = idx + lo
+        bs = hidden_states.shape[0]
+        # 4 slots per rank: the max logit and the index as three base-256 digits (exact in bf16 / fp16).
+        packed = torch.zeros((bs, size, 4), dtype=weight.dtype, device=weight.device)
+        packed[:, rank, 0] = val
+        packed[:, rank, 1] = (idx >> 16).to(weight.dtype)
+        packed[:, rank, 2] = ((idx >> 8) & 255).to(weight.dtype)
+        packed[:, rank, 3] = (idx & 255).to(weight.dtype)
+        packed = group.all_reduce(packed.view(bs, size * 4)).view(bs, size, 4)
+        best = packed[:, :, 0].float().argmax(dim=-1, keepdim=True)  # first max = lowest rank on a tie
+        digits = packed.gather(1, best[:, :, None].expand(bs, 1, 4))[:, 0, 1:].long()
+        token = (digits[:, 0] << 16) | (digits[:, 1] << 8) | digits[:, 2]
+        if out is not None and out.shape == (bs, vocab):
+            logits = out.zero_()
+        else:
+            logits = torch.zeros((bs, vocab), dtype=torch.float32, device=weight.device)
+        logits.scatter_(1, token[:, None], 1.0)
+        return logits
+
 logger = logging.getLogger(__name__)
 
 
