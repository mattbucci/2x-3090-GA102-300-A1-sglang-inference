+    def _draft_topk(self, logits: torch.Tensor):
+        """[3090 097] top-k draft tokens and their probabilities. A greedy chain (topk == 1) only
+        needs the argmax, so the softmax over the vocabulary is skipped (the score is unused)."""
+        if self.topk == 1 and _MTP_DRAFT_ARGMAX:
+            topk_index = torch.argmax(logits, dim=-1, keepdim=True)
+            return torch.ones_like(topk_index, dtype=torch.float32), topk_index
+        probs = torch.softmax(logits, dim=-1)
+        return fast_topk(probs, self.topk, dim=-1)
