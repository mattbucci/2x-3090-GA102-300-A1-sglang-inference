+++ b/python/sglang/srt/environ.py
@@ -555,6 +555,9 @@ class Envs:
     # INT4 weight made per call) for calls with at least this many rows; 0 = off (decode stays W4A16).
     SGLANG_AWQ_W4A8_PREFILL_MIN_TOKENS = EnvInt(0)
     SGLANG_LM_HEAD_INT8 = EnvBool(False)
+    # [3090 084] Tied heads (Gemma 4): materialize a separate head so the INT8 repack applies;
+    # the embedding table stays dense. Costs the INT8 copy in VRAM (half the bf16 table).
+    SGLANG_LM_HEAD_INT8_UNTIE = EnvBool(False)
     # Scale granularity for the INT8 head: -1 = per output channel, or a group size
     # (32 / 64 / 128) along the hidden dim; Marlin takes either.
     SGLANG_LM_HEAD_INT8_GROUP = EnvInt(-1)
