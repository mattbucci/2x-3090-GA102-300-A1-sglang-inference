+def _resolve_model_quant_config(model):
+    """[3090 073] The piecewise forward context carries the model's quant config and
+    ``unified_apply_gptq_marlin_gemm`` reads ``quant_type`` from it, so a ``None`` here
+    crashes the prefill-graph capture inside the first Marlin GEMM. Multimodal proxy
+    classes (``Mistral3ForConditionalGeneration`` -> ``LlavaForConditionalGeneration``
+    -> ``language_model``) expose no top-level ``quant_config``; walk the usual wrapper
+    attributes, then fall back to the first quantized module's method."""
+    seen = []
+    for obj in (
+        model,
+        getattr(model, "language_model", None),
+        getattr(model, "inner", None),
+        getattr(getattr(model, "inner", None), "language_model", None),
+    ):
+        if obj is None or any(obj is x for x in seen):
+            continue
+        seen.append(obj)
+        qc = getattr(obj, "quant_config", None)
+        if qc is not None:
+            return qc
+    modules = getattr(model, "modules", None)
+    if callable(modules):
+        for mod in modules():
+            qc = getattr(getattr(mod, "quant_method", None), "quant_config", None)
+            if qc is not None:
+                return qc
+    return None
+
