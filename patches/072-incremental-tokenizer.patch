diff --git a/python/sglang/srt/managers/incremental_tokenizer.py b/python/sglang/srt/managers/incremental_tokenizer.py
new file mode 100644
index 0000000000..e18050f2d6
--- /dev/null
+++ b/python/sglang/srt/managers/incremental_tokenizer.py
@@ -0,0 +1,152 @@
+"""[3090 072] Incremental tokenization for append-only prompts (the agentic follow-up turn at depth).
+
+Every chat turn re-sends the whole conversation and the server re-tokenizes it from scratch: Flint's fast
+tokenizer runs at ~1.7 us/token, so a 253K-token turn pays ~420 ms of the 466 ms it costs after the split-KV
+route (qwen38 ~0.6 us/token). HF tokenizers split the text on added/special tokens *before* pre-tokenization and
+BPE and encode each segment independently, so for two texts that share a prefix the tokens up to the last added
+token inside the common prefix are identical. This cache keeps the last few (text, ids, added-token boundaries)
+and encodes only the tail after that boundary.
+
+Exactness conditions (checked once; the cache stays disabled otherwise): fast tokenizer; no added token with
+lstrip / rstrip / normalized / single_word (any of these lets a match reach outside its segment); for the
+add_special_tokens=True mode the post-processor must add only a prefix (BOS), never a suffix.
+Env: SGLANG_INCREMENTAL_TOKENIZE=1 enables, SGLANG_INCREMENTAL_TOKENIZE_VERIFY=1 also runs the full encode on
+every call and logs + returns it on any mismatch (gate runs).
+"""
+from __future__ import annotations
+
+import bisect
+import logging
+import os
+import threading
+import time
+from typing import List, Optional, Tuple
+
+logger = logging.getLogger(__name__)
+
+ENABLED = os.environ.get("SGLANG_INCREMENTAL_TOKENIZE", "0") not in ("", "0", "false", "False")
+VERIFY = os.environ.get("SGLANG_INCREMENTAL_TOKENIZE_VERIFY", "0") not in ("", "0", "false", "False")
+MAX_ENTRIES = int(os.environ.get("SGLANG_INCREMENTAL_TOKENIZE_ENTRIES", "8") or 8)
+MIN_CHARS = 4096  # below this a full encode is cheaper than the bookkeeping
+
+
+def _common_prefix_len(a: str, b: str) -> int:
+    """Length of the common prefix of two strings in O(log n) C-level slice compares."""
+    if a is b or a == b:
+        return len(a)
+    n = min(len(a), len(b))
+    if n == 0 or a[0] != b[0]:
+        return 0
+    if a[:n] == b[:n]:
+        return n
+    lo, hi = 0, n  # invariant: a[:lo] == b[:lo], a[:hi] != b[:hi]
+    while hi - lo > 1:
+        mid = (lo + hi) // 2
+        if a[:mid] == b[:mid]:
+            lo = mid
+        else:
+            hi = mid
+    return lo
+
+
+class _Entry:
+    __slots__ = ("text", "ids", "ends", "ntoks", "mode")
+
+    def __init__(self, text, ids, ends, ntoks, mode):
+        self.text, self.ids, self.ends, self.ntoks, self.mode = text, ids, ends, ntoks, mode
+
+
+class IncrementalTokenizer:
+    def __init__(self, tokenizer, max_entries: int = MAX_ENTRIES, verify: bool = VERIFY):
+        self.tok = tokenizer
+        self.max_entries = max_entries
+        self.verify = verify
+        self._entries: List[_Entry] = []
+        self._lock = threading.Lock()
+        self.stats = {"calls": 0, "hits": 0, "reused_tokens": 0, "encoded_tokens": 0, "mismatches": 0, "saved_s": 0.0}
+        self.enabled, self.special_prefix_ok, why = self._check(tokenizer)
+        self._added = set(tokenizer.added_tokens_decoder.keys()) if self.enabled else set()
+        if self.enabled:
+            logger.info("[072] incremental tokenizer on (%d added tokens, add_special_tokens mode %s)",
+                        len(self._added), "ok" if self.special_prefix_ok else "off")
+        else:
+            logger.info("[072] incremental tokenizer disabled: %s", why)
+
+    @staticmethod
+    def _check(tok) -> Tuple[bool, bool, str]:
+        if not getattr(tok, "is_fast", False):
+            return False, False, "not a fast tokenizer"
+        dec = getattr(tok, "added_tokens_decoder", None)
+        if not dec:
+            return False, False, "no added tokens"
+        for t in dec.values():
+            if t.lstrip or t.rstrip or t.normalized or t.single_word:
+                return False, False, f"added token {t.content!r} has lstrip/rstrip/normalized/single_word"
+        try:
+            probe = "a b"
+            with_sp = tok(probe, add_special_tokens=True)["input_ids"]
+            without = tok(probe, add_special_tokens=False)["input_ids"]
+            prefix_ok = len(with_sp) >= len(without) and with_sp[len(with_sp) - len(without):] == without
+        except Exception as e:  # noqa: BLE001
+            return False, False, f"probe failed: {e}"
+        return True, prefix_ok, ""
+
+    def _encode_full(self, text: str, add_special_tokens: bool):
+        enc = self.tok(text, add_special_tokens=add_special_tokens, return_offsets_mapping=True)
+        ids = enc["input_ids"]
+        offs = enc["offset_mapping"]
+        ends, ntoks = [], []
+        added = self._added
+        for i, tid in enumerate(ids):
+            if tid in added:
+                s, e = offs[i]
+                if e > s:  # an added token present in the text (post-processor specials have (0, 0))
+                    ends.append(e)
+                    ntoks.append(i + 1)
+        return ids, ends, ntoks
+
+    def encode(self, text: str, add_special_tokens: bool = False) -> List[int]:
+        if not self.enabled or (add_special_tokens and not self.special_prefix_ok) or len(text) < MIN_CHARS:
+            return self.tok(text, add_special_tokens=add_special_tokens)["input_ids"]
+        mode = bool(add_special_tokens)
+        t0 = time.perf_counter()
+        best = None  # (char_end, ntok, entry)
+        with self._lock:
+            self.stats["calls"] += 1
+            for e in self._entries:
+                if e.mode != mode or not e.ends:
+                    continue
+                lcp = len(e.text) if text.startswith(e.text) else _common_prefix_len(e.text, text)
+                j = bisect.bisect_right(e.ends, lcp) - 1
+                if j >= 0 and (best is None or e.ends[j] > best[0]):
+                    best = (e.ends[j], e.ntoks[j], e, j)
+        if best is None:
+            ids, ends, ntoks = self._encode_full(text, add_special_tokens)
+            self.stats["encoded_tokens"] += len(ids)
+            self._store(_Entry(text, ids, ends, ntoks, mode))
+            return ids
+        char_end, ntok, e, j = best
+        tail_ids, tail_ends, tail_ntoks = self._encode_full(text[char_end:], False)
+        ids = e.ids[:ntok] + tail_ids
+        ends = e.ends[: j + 1] + [char_end + c for c in tail_ends]
+        ntoks = e.ntoks[: j + 1] + [ntok + n for n in tail_ntoks]
+        self.stats["hits"] += 1
+        self.stats["reused_tokens"] += ntok
+        self.stats["encoded_tokens"] += len(tail_ids)
+        if self.verify:
+            full = self.tok(text, add_special_tokens=add_special_tokens)["input_ids"]
+            if full != ids:
+                self.stats["mismatches"] += 1
+                logger.error("[072] incremental tokenization MISMATCH (reused %d tokens, %d vs %d ids) — full encode returned",
+                             ntok, len(ids), len(full))
+                ids, ends, ntoks = self._encode_full(text, add_special_tokens)
+        self._store(_Entry(text, ids, ends, ntoks, mode))
+        self.stats["saved_s"] += max(0.0, ntok * 1e-6 - (time.perf_counter() - t0))  # rough: ~1 us/token full encode
+        return ids
+
+    def _store(self, entry: _Entry):
+        with self._lock:
+            # drop an older entry this one extends (same mode, prefix of the new text)
+            self._entries = [e for e in self._entries if not (e.mode == entry.mode and entry.text.startswith(e.text))]
+            self._entries.insert(0, entry)
+            del self._entries[self.max_entries:]
