--- /dev/null
+++ b/python/sglang/srt/layers/quantization/awq_w4a8_prefill.py
@@ -0,0 +1,159 @@
+"""[3090 071] W4A8 prefill for AWQ-Marlin linears: INT8 tensor-core GEMMs for the big-M (prefill) calls.
+
+On the unlocked GA102s CUTLASS ``int8_scaled_mm`` runs ~2x the FP16 rate the Marlin W4A16 kernel is bound by at
+M = 8192 (benchmarks/gpu-unlock-2026-10-22/int8-imma-check-2026-11-01.md; the Marlin GEMM chain is 67 % of a cold 32K
+prefill, benchmarks/profiling/prefill-profile-2026-11-01.md). Decode (M = 1) stays on Marlin W4A16 — INT8 would double
+the weight bytes it streams.
+
+Per call with M >= SGLANG_AWQ_W4A8_PREFILL_MIN_TOKENS:
+  1. a Triton kernel reads the *Marlin-permuted* INT4 weight tile by tile, places each nibble back at its logical
+     (k, n) through the recovered intra-tile table (``recover_tile_table``: ``awq_marlin_repack`` is a value-independent
+     permutation, so encoding nibble positions across 7 repacks of a small shape recovers it exactly — validated
+     against Marlin(I_K) in scripts/eval/test_marlin_tile_perm.py), dequantises ``(q - z) * s`` with the unpermuted
+     per-group scales / zeros kept at load, and rounds to INT8 with a per-output-channel scale (also fixed at load);
+  2. per-token INT8 activations (``per_token_quant_int8``) x that INT8 weight through ``int8_scaled_mm``.
+The transient INT8 weight is <= 2x the packed INT4 bytes and lives only for the call.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.srt.environ import envs
+
+logger = logging.getLogger(__name__)
+
+AWQ_INTERLEAVE = torch.tensor([0, 2, 4, 6, 1, 3, 5, 7])
+
+
+def _awq_marlin_repack(packed, k, n, bits):
+    from sglang.kernels.ops.quantization.awq_marlin_repack import awq_marlin_repack
+
+    return awq_marlin_repack(packed, size_k=k, size_n=n, num_bits=bits)
+
+TILE_K, TILE_N = 16, 64
+_TABLE_CACHE: dict = {}
+
+
+def _awq_pack(q_kn: torch.Tensor) -> torch.Tensor:
+    """logical uint4 [K, N] (int32) -> AWQ-packed int32 [K, N/8] (nibble i of word j = logical col 8j + interleave[i])."""
+    from sglang.srt.layers.quantization.utils import pack_cols
+
+    k, n = q_kn.shape
+    q_il = q_kn.reshape(k, n // 8, 8)[:, :, AWQ_INTERLEAVE.to(q_kn.device)].reshape(k, n)
+    return pack_cols(q_il.to(torch.int32), 4, k, n)
+
+
+def _nibbles(words: torch.Tensor) -> torch.Tensor:
+    w = words.to(torch.int64) & 0xFFFFFFFF
+    return torch.stack([((w >> (4 * i)) & 0xF) for i in range(8)], dim=-1).reshape(words.shape[0], -1)
+
+
+def recover_tile_table(device) -> torch.Tensor:
+    """inv[kk * 64 + nn] = index (0..1023) of the nibble inside a Marlin 16x64 tile that holds logical (kk, nn).
+    Recovered once per process from ``awq_marlin_repack`` on a 64 x 256 probe (4 tiles: periodicity is checked)."""
+    key = str(device)
+    t = _TABLE_CACHE.get(key)
+    if t is not None:
+        return t
+    k, n = 64, 256
+    idx = torch.arange(k * n, device=device, dtype=torch.int64).reshape(k, n)
+    src = torch.zeros((k // TILE_K) * (n * 2) * 8, device=device, dtype=torch.int64)
+    for p in range(4):  # 16 bits >= log2(64 * 256)
+        q = ((idx >> (4 * p)) & 0xF).to(torch.int32)
+        m = _awq_marlin_repack(_awq_pack(q).contiguous(), k, n, 4)
+        src |= _nibbles(m).reshape(-1) << (4 * p)
+    R, C = k // TILE_K, n * 16
+    src_k = (src // n).reshape(R, C) - TILE_K * torch.arange(R, device=device)[:, None]
+    src_n = (src % n).reshape(R, C)
+    groups = C // (TILE_K * TILE_N)
+    n_base = src_n.reshape(R, groups, -1) // TILE_N
+    if not bool((n_base == n_base[..., :1]).all()) or not bool((src_k >= 0).all()) or not bool((src_k < TILE_K).all()):
+        raise RuntimeError("awq_marlin_repack layout is not 16x64-tile periodic on this build")
+    intra = (src_k.reshape(R, groups, -1) * TILE_N + src_n.reshape(R, groups, -1) % TILE_N)
+    table = intra[0, 0]
+    if not bool((intra == table).all()) or not bool(torch.equal(n_base[0, :, 0], torch.arange(groups, device=device))):
+        raise RuntimeError("awq_marlin_repack intra-tile order differs between tiles on this build")
+    inv = torch.empty(TILE_K * TILE_N, device=device, dtype=torch.int32)
+    inv[table] = torch.arange(TILE_K * TILE_N, device=device, dtype=torch.int32)
+    _TABLE_CACHE[key] = inv
+    return inv
+
+
+@triton.jit
+def _marlin_w4_to_int8_kernel(
+    mq_ptr,  # Marlin int32 [K/16, N*2]
+    inv_ptr,  # int32 [1024]: logical (kk*64+nn) -> nibble index in the tile
+    z_ptr,  # uint8 [K/g, N] zero points (logical)
+    s_ptr,  # fp16  [K/g, N] group scales (logical)
+    sc_ptr,  # fp32  [N] per-output-channel INT8 scale
+    w8_ptr,  # int8  [N, K] out (row-major = the [K, N] column-major operand int8_scaled_mm wants)
+    K, N, GROUP,
+    stride_mq_r,
+):
+    r = tl.program_id(0)  # k-tile
+    c = tl.program_id(1)  # n-tile
+    kk = tl.arange(0, 16)
+    nn = tl.arange(0, 64)
+    idx = tl.load(inv_ptr + kk[:, None] * 64 + nn[None, :])  # [16, 64] nibble index in tile
+    word = tl.load(mq_ptr + r * stride_mq_r + c * 128 + idx // 8)  # tile = 128 contiguous words
+    q = (word >> ((idx % 8) * 4)) & 0xF
+    k0 = r * 16
+    n0 = c * 64
+    gi = k0 // GROUP
+    z = tl.load(z_ptr + gi * N + n0 + nn).to(tl.float32)  # [64]
+    s = tl.load(s_ptr + gi * N + n0 + nn).to(tl.float32)  # [64]
+    sc = tl.load(sc_ptr + n0 + nn)  # [64]
+    w = (q.to(tl.float32) - z[None, :]) * s[None, :]
+    w8 = tl.extra.cuda.libdevice.rint(w / sc[None, :]) if hasattr(tl.extra, "cuda") else (w / sc[None, :] + 0.5 * tl.where(w >= 0, 1.0, -1.0))
+    w8 = tl.minimum(tl.maximum(w8, -127.0), 127.0).to(tl.int8)
+    # store transposed: w8_ptr[n, k]
+    tl.store(w8_ptr + (n0 + nn)[None, :] * K + (k0 + kk)[:, None], w8)
+
+
+def prepare_layer(layer: torch.nn.Module, scales_kn: torch.Tensor, zeros_kn: torch.Tensor, group: int) -> None:
+    """Called at load (before the originals are dropped): keep logical scales / zeros and fix the per-channel INT8 scale.
+    max|w| per output channel = max over groups of s * max(q - z) with q in [0, 15]: exact, no dequant pass needed."""
+    with torch.no_grad():
+        z = zeros_kn.to(torch.float32)
+        s = scales_kn.to(torch.float32)
+        amax = torch.maximum((15.0 - z).abs(), z.abs()) * s.abs()  # [K/g, N]
+        sc = (amax.amax(dim=0) / 127.0).clamp_(min=1e-8)  # [N]
+    layer.w4a8_scales = torch.nn.Parameter(scales_kn.to(torch.float16).contiguous(), requires_grad=False)
+    layer.w4a8_zeros = torch.nn.Parameter(zeros_kn.to(torch.uint8).contiguous(), requires_grad=False)
+    layer.w4a8_chan_scale = torch.nn.Parameter(sc.contiguous(), requires_grad=False)
+    layer.w4a8_group = int(group)
+
+
+def dequant_to_int8(layer: torch.nn.Module, K: int, N: int) -> torch.Tensor:
+    inv = recover_tile_table(layer.qweight.device)
+    w8 = torch.empty((N, K), dtype=torch.int8, device=layer.qweight.device)
+    grid = (K // TILE_K, N // TILE_N)
+    _marlin_w4_to_int8_kernel[grid](
+        layer.qweight, inv, layer.w4a8_zeros, layer.w4a8_scales, layer.w4a8_chan_scale, w8,
+        K, N, layer.w4a8_group, layer.qweight.stride(0), num_warps=4,
+    )
+    return w8
+
+
+def applicable(layer: torch.nn.Module, x: torch.Tensor) -> bool:
+    m = envs.SGLANG_AWQ_W4A8_PREFILL_MIN_TOKENS.get()
+    if m <= 0 or not hasattr(layer, "w4a8_chan_scale"):
+        return False
+    rows = x.numel() // x.shape[-1]
+    return rows >= m and x.dtype in (torch.float16, torch.bfloat16)
+
+
+def apply_w4a8(layer: torch.nn.Module, x: torch.Tensor, bias: Optional[torch.Tensor], K: int, N: int) -> torch.Tensor:
+    from sgl_kernel import int8_scaled_mm
+    from sglang.kernels.ops.quantization.int8_kernel import per_token_quant_int8
+
+    x2 = x.reshape(-1, K)
+    w8 = dequant_to_int8(layer, K, N)  # [N, K] row-major
+    xq, xs = per_token_quant_int8(x2)
+    out = int8_scaled_mm(xq, w8.t(), xs, layer.w4a8_chan_scale, x.dtype, bias)
+    return out.reshape(x.shape[:-1] + (N,))
